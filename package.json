{
  "name": "dsh-speak-her",
  "version": "0.1.1",
  "description": "自动朗读：把她的每句话用 edge-tts 或 BreezeBlue 云端音色念出来，音色 / 语速 / 音调都能在设置页调。",
  "license": "MIT",
  "type": "module",
  "keywords": ["dsh", "dsh-plugin", "tts", "read-aloud", "edge-tts", "breezeblue"],
  "engines": {
    "node": ">=22"
  },
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check:secrets": "node tests/check-secrets.mjs"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0key1-W/dsh-speak-her.git"
  },
  "bugs": {
    "url": "https://github.com/0key1-W/dsh-speak-her/issues"
  },
  "homepage": "https://github.com/0key1-W/dsh-speak-her#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["slots"],
      "external": ["react"]
    }
  }
}
